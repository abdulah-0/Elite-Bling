# Supabase
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Rapid Gateway (existing)
RG_MERCHANT_ID=your-merchant-id
RG_CLIENT_SECRET=your-client-secret

# App
BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# Swich PayIn Configuration (Reference: docs/implementation.prd.md Appendix A)
# ============================================================
SWICH_ENABLED=true
SWICH_ENV=sandbox                      # sandbox | production
SWICH_CLIENT_ID=your-swich-client-id
SWICH_CLIENT_SECRET=your-swich-client-secret
SWICH_SECRET_KEY=your-swich-secret-key # HMAC key for checksums

# Optional overrides (derived from SWICH_ENV if omitted)
# SWICH_API_BASE_URL=https://sandbox-api.swichnow.com
# SWICH_AUTH_URL=https://sandbox-auth.swichnow.com/connect/token
# SWICH_PWA_URL=https://sandbox-payin-pwa.swichnow.com/
# SWICH_PWA_POST_URL=https://sandbox-payinpwa20.swichnow.com/Transaction/Index

# Behavior & Limits
SWICH_LANDING_MODE=get                 # get | post
# SWICH_AES_KEY=                       # POST mode only
# SWICH_AES_IV=                        # POST mode only
SWICH_MIN_AMOUNT=10
SWICH_MAX_AMOUNT=50000
SWICH_ATTEMPT_TTL_MINUTES=60
# SWICH_TRANSACTION_TYPE=              # only if Swich requires it on landing page

# Reconciliation & Security
CRON_SECRET=your-secure-cron-secret-here

# Phase 2+ (Operations / Direct APIs)
# FIXED_IP_GATEWAY_URL=
# FIXED_IP_GATEWAY_SECRET=
